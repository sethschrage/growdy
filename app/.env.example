VITE_SUPABASE_URL=https://fostmbhpnhjzhulphxzp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Native Google sign-in (iOS shell). Create these in Google Cloud Console.
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=

# The public web address share links should point at. Only used when the
# app is running from a bundle (the iOS shell), where window.location is
# capacitor://localhost and no other device can resolve it. A browser
# build ignores this and links to whatever origin it is served from, so
# a preview deployment links to itself.
VITE_PUBLIC_ORIGIN=https://app-blue-ten-25.vercel.app
