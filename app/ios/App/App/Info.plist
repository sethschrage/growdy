	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.839193339289-8vcgecqrrbbvh5npa8j4v3qquk25hr9s</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>growdy uses the camera so you can photograph what you see in the vineyard and log it as an observation.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>growdy saves the photos you take back to your library at full resolution, so the original stays on your phone while the app keeps a smaller copy.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>growdy needs your photo library so you can attach a vineyard photo you already took.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
